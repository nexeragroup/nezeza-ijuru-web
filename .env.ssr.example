# Absolute API origin used by the Node SSR process.
# The browser continues to call /api/v1 through the reverse proxy.
SSR_API_BASE_URL=https://api.nezezaijuru.org/api/v1

# Public origin used for canonical URLs, robots.txt, and sitemap.xml.
SITE_URL=https://nezezaijuru.org

# Keep non-production local SSR deployments out of search indexes.
ROBOTS_INDEXABLE=false
